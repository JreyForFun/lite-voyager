{
  "name": "lite-voyager",
  "displayName": "Lite Voyager",
  "publisher": "jreyinnovarev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JreyForFun/lite-voyager.git"
  },
  "description": "Your new favorite go to SQLite and data files tool",
  "version": "0.0.1",
  "engines": {
    "node": ">=25.7.0",
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lite-voyager.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "build": "node esbuild.js --production",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "node scripts/package-check.mts",
    "compile-tests": "tsc -p tsconfig.integration.json",
    "watch-tests": "tsc -p tsconfig.integration.json --watch",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit && tsc -p tsconfig.tooling.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:integration": "npm run compile-tests && npm run build && node scripts/integration-check.mts",
    "verify": "node scripts/verify.mts",
    "verify:full": "node scripts/verify.mts --full",
    "fixtures": "node scripts/generate-fixtures.mts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
